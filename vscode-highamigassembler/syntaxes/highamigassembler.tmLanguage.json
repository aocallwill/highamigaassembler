{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "High Amiga Assembler",
  "scopeName": "source.highamigassembler",
  "fileTypes": ["has"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#include-directive" },
    { "include": "#import-directive" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#asm-block" },
    { "include": "#function-definitions" },
    { "include": "#sections" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#registers" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#suffixes" }
  ],

  "repository": {
    "asm-block": {
      "begin": "\\b(asm)\\s*\\{",
      "beginCaptures": {
        "1": { "name": "keyword.control.highamigassembler" }
      },
      "end": "\\}",
      "name": "meta.asm-block.highamigassembler",
      "patterns": [
        {
          "name": "comment.line.semicolon.asm.highamigassembler",
          "match": ";.*$"
        },
        { "include": "#strings" },
        { "include": "#pseudo-ops" },
        { "include": "#instructions" },
        { "include": "#registers" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#suffixes" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.highamigassembler",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.highamigassembler",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.highamigassembler",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.if.highamigassembler",
          "match": "^\\s*#if\\b"
        },
        {
          "name": "keyword.directive.ifdef.highamigassembler",
          "match": "^\\s*#ifdef\\b"
        },
        {
          "name": "keyword.directive.ifndef.highamigassembler",
          "match": "^\\s*#ifndef\\b"
        },
        {
          "name": "keyword.directive.else.highamigassembler",
          "match": "^\\s*#else\\b"
        },
        {
          "name": "keyword.directive.endif.highamigassembler",
          "match": "^\\s*#endif\\b"
        },
        {
          "name": "keyword.directive.highamigassembler",
          "match": "^\\s*(#(?:warning|error|pragma))\\b",
          "captures": {
            "1": { "name": "keyword.directive.highamigassembler" }
          }
        }
      ]
    },
    "include-directive": {
      "patterns": [
        {
          "begin": "^\\s*(#include)\\s+(<)",
          "beginCaptures": {
            "1": { "name": "keyword.directive.include.highamigassembler" },
            "2": { "name": "punctuation.definition.string.begin.highamigassembler" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.highamigassembler" }
          },
          "name": "meta.preprocessor.include.highamigassembler",
          "contentName": "string.quoted.other.highamigassembler"
        },
        {
          "begin": "^\\s*(#include)\\s+(\")",
          "beginCaptures": {
            "1": { "name": "keyword.directive.include.highamigassembler" },
            "2": { "name": "punctuation.definition.string.begin.highamigassembler" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.highamigassembler" }
          },
          "name": "meta.preprocessor.include.highamigassembler",
          "contentName": "string.quoted.double.highamigassembler"
        }
      ]
    },
    "import-directive": {
      "patterns": [
        {
          "begin": "^\\s*(#import)\\s+(bob|palette|sprite|atlas|tileset|tilemap)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.directive.import.highamigassembler" },
            "2": { "name": "support.type.import-kind.highamigassembler" }
          },
          "end": ";",
          "endCaptures": {
            "0": { "name": "punctuation.terminator.statement.highamigassembler" }
          },
          "name": "meta.preprocessor.import.highamigassembler",
          "patterns": [
            { "include": "#strings" },
            {
              "name": "keyword.other.import-as.highamigassembler",
              "match": "\\bas\\b"
            },
            {
              "name": "support.variable.import-option.highamigassembler",
              "match": "\\b(?:planes|colors|dither|add_word|shared_palette|dedupe|sprites|atlas_png|tile_w|tile_h|tile_width|tile_height|match_palette|strict_palette|layer|allow_flip|index_size|firstgid|tileset|kind|vstart|vstop|index0|requantize|restore_original_size)\\b"
            },
            {
              "name": "entity.name.label.import.highamigassembler",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "include": "#numbers" },
            {
              "name": "keyword.operator.assignment.highamigassembler",
              "match": "="
            },
            {
              "name": "punctuation.separator.comma.highamigassembler",
              "match": "[,+]"
            }
          ]
        },
        {
          "name": "keyword.directive.import.highamigassembler",
          "match": "^\\s*#import\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.highamigassembler",
          "match": "\\b(?:func|proc|interrupt)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.highamigassembler" }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "keyword.control.section.highamigassembler",
          "match": "\\b(?:data_chip|data|bss_chip|bss|code_chip|code)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.proc.highamigassembler",
          "match": "\\bproc\\b"
        },
        {
          "name": "keyword.declaration.func.highamigassembler",
          "match": "\\bfunc\\b"
        },
        {
          "name": "keyword.declaration.interrupt.highamigassembler",
          "match": "\\binterrupt\\b"
        },
        {
          "name": "keyword.modifier.native.highamigassembler",
          "match": "\\bnative\\b"
        },
        {
          "name": "keyword.control.highamigassembler",
          "match": "\\b(?:extern|public|macro|const|var|struct|return|if|else|while|do|for|to|by|repeat|loop|break|continue|call|asm|starti|endi|PUSH|POP)\\b"
        },
        {
          "name": "keyword.other.decorator.highamigassembler",
          "match": "@python"
        },
        {
          "name": "keyword.other.register.highamigassembler",
          "match": "__reg"
        },
        {
          "name": "support.function.builtin.highamigassembler",
          "match": "\\b(?:GetReg|SetReg)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.highamigassembler",
          "match": "\\b(?:int|word|long|void|byte|bool|u8|u16|u32|i8|i16|i32|ptr)\\b"
        }
      ]
    },
    "pseudo-ops": {
      "patterns": [
        {
          "name": "keyword.other.pseudo-op.highamigassembler",
          "match": "(?i)\\b(?:dc|dcb|ds|even|cnop|section|xdef|xref|equ|set|org|end|incbin|rept|endr|macro|endm|ifd|ifnd|ifne|ifeq|else|endif|include)\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.other.instruction.highamigassembler",
          "match": "(?i)\\b(?:move|movem|moveq|add|addi|addq|addx|sub|subi|subq|subx|mulu|muls|divu|divs|and|andi|or|ori|eor|eori|not|clr|lea|pea|jsr|jmp|rts|rtr|rte|bra|bsr|bcc|bcs|bne|beq|bge|bgt|ble|blt|bhi|bls|bvc|bvs|bpl|bmi|dbra|dbf|dbne|dbeq|scc|scs|sne|seq|sge|sgt|sle|slt|shi|sls|svc|svs|spl|smi|tst|swap|ext|extb|neg|negx|nop|link|unlk|chk|trap|stop|reset|btst|bset|bclr|bchg|asl|asr|lsl|lsr|rol|ror|roxl|roxr|abcd|sbcd|nbcd|cmp|cmpi|cmpa|cmpm|exg)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.highamigassembler",
          "match": "(?i)\\b(?:d[0-7]|a[0-7]|sp|pc|sr|ccr)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.highamigassembler",
          "match": "\\b(?:0x[0-9A-Fa-f]+|\\$[0-9A-Fa-f]+)\\b"
        },
        {
          "name": "constant.numeric.binary.highamigassembler",
          "match": "\\b%[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.highamigassembler",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.highamigassembler",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.comparison.highamigassembler",
          "match": "==|!=|<=|>=|<<|>>|<>"
        },
        {
          "name": "keyword.operator.logical.highamigassembler",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.highamigassembler",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.highamigassembler",
          "match": "[&\\|^~]"
        },
        {
          "name": "keyword.operator.other.highamigassembler",
          "match": "!|->"
        }
      ]
    },
    "suffixes": {
      "patterns": [
        {
          "name": "storage.modifier.size-suffix.highamigassembler",
          "match": "(?i)\\.[bwl]\\b"
        }
      ]
    }
  }
}
